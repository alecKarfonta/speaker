# MOSS-TTS-Realtime distillation experiment (example — copy to experiment.yaml)

voice_ref: data/voices/loli/loli_15s.wav
teacher: v15
corpus: corpus/texts.jsonl
train_raw: train_raw.jsonl

parallel:
  num_shards: 4
  gpus: [0, 1, 2, 3]
  ports: [8014, 8015, 8016, 8017]
  staging_dir: /dev/shm/moss_rt_wavs
  teachers: v15

sft:
  noref: true
  lora_r: 16
  epochs: 12
  lr: 3.0e-6
  grad_accum: 4
  warmup_ratio: 0

export:
  checkpoint: checkpoints/latest
  merged: exports/merged

qc:
  wav_dir: wavs/v15
  wav_dir_pruned: wavs/v15_pruned
  stt_api: http://localhost:8603/v1/audio/transcriptions

serve:
  api_url: http://127.0.0.1:8016
  native_voice: true
