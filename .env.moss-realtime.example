# Copy to .env.moss-realtime and run:
#   docker compose --env-file .env.moss-realtime up -d moss-realtime
COMPOSE_PROFILES=moss-realtime
MOSS_RT_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Realtime
MOSS_RT_BASE_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Realtime
MOSS_RT_NATIVE_VOICE=false
# After merge + bind-mount (see docs/moss-realtime-finetune.md):
# MOSS_RT_MODEL_ID=/models/merged
# MOSS_RT_NATIVE_VOICE=true
