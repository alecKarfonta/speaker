# Copy to .env.moss-realtime and run:
#   docker compose --env-file .env.moss-realtime up -d openmoss-tts moss-realtime
COMPOSE_PROFILES=moss-realtime

# Batch /tts on :8016 → openmoss-tts C++ GGML (~0.36× RTF on Blackwell)
MOSS_BATCH_ENGINE=openmoss
OPENMOSS_TTS_URL=http://openmoss-tts:8000
MOSS_ENABLE_MAIN_MODEL=false
MOSS_ENABLE_REALTIME=false
MOSS_MODEL_ID=OpenMOSS-Team/MOSS-TTS-v1.5

# openmoss C++ GPU (host index). Default 0 = RTX 5070 Ti.
OPENMOSS_GPU_ID=0
# Set true if codec decode OOMs on a full GPU; false is faster when VRAM has headroom.
OPENMOSS_AUX_CPU=false

# Finetune streaming (epoch-7 merged): see .env.moss-rt-loli and models/loli15s-epoch7-merged/
#   docker compose --env-file .env.moss-rt-loli up -d moss-realtime --no-build

# Realtime streaming (optional — re-enable and add GPU to moss-realtime)
MOSS_RT_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Realtime
MOSS_RT_BASE_MODEL_ID=OpenMOSS-Team/MOSS-TTS-Realtime
MOSS_RT_NATIVE_VOICE=false

# After LoRA merge + bind-mount (see docs/moss-realtime-finetune.md):
# MOSS_RT_MODEL_ID=/models/loli15s-v2-noref-max-lora
# MOSS_RT_NATIVE_VOICE=true
